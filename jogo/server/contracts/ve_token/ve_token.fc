;; ALPHA VE (Void Energy) Token Contract
;; Jetton standard implementation for VE token on TON

#include "imports/stdlib.fc";

;; Storage
const int idx_admin = 0;
const int idx_total_supply = 1;
const int idx_max_supply = 2;
const int idx_mint_rate = 3;; per hour

;; Operations
const int op_mint = 0x55555555;
const int op_burn = 0x66666666;
const int op_transfer = 0x77777777;
const int op_set_mint_rate = 0x88888888;

() save_data(slice admin, int total_supply, int max_supply, int mint_rate) impure {
    set_data(begin_cell()
        .store_slice(admin)
        .store_coins(total_supply)
        .store_coins(max_supply)
        .store_coins(mint_rate)
    .end_cell());
}

(slice, int, int, int) load_data() {
    var ds = get_data().begin_parse();
    return (
        ds~load_msg_addr(),
        ds~load_coins(),
        ds~load_coins(),
        ds~load_coins()
    );
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) return ();
    slice sender = cs~load_msg_addr();

    var (admin, total_supply, max_supply, mint_rate) = load_data();

    if (in_msg_body.slice_empty?()) return ();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    if (op == op_mint) {
        ;; Only admin can mint
        throw_unless(400, equal_slices(sender, admin));
        slice to = in_msg_body~load_msg_addr();
        int amount = in_msg_body~load_coins();
        throw_unless(401, total_supply + amount <= max_supply);

        total_supply += amount;

        ;; In production: send jetton transfer to 'to' address
        ;; For now, just update supply counter
        save_data(admin, total_supply, max_supply, mint_rate);
        return ();
    }

    if (op == op_burn) {
        int amount = in_msg_body~load_coins();
        throw_unless(410, total_supply >= amount);
        total_supply -= amount;
        save_data(admin, total_supply, max_supply, mint_rate);
        return ();
    }

    if (op == op_set_mint_rate) {
        throw_unless(420, equal_slices(sender, admin));
        int new_rate = in_msg_body~load_coins();
        save_data(admin, total_supply, max_supply, new_rate);
        return ();
    }

    throw(0xffff);
}

(int, int, int) get_token_data() method_id {
    var (_, total_supply, max_supply, mint_rate) = load_data();
    return (total_supply, max_supply, mint_rate);
}
